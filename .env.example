# Скопируйте этот файл в .env.local и заполните значения.
# Все переменные должны начинаться с VITE_, иначе Vite не передаст их в клиентский код.

# Firebase: Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# TMDB: https://www.themoviedb.org/settings/api
# Подходит и API Key (v3), и API Read Access Token (v4) — приложение определит тип само.
VITE_TMDB_API_KEY=

# Язык данных TMDB (по умолчанию ru-RU)
VITE_TMDB_LANGUAGE=ru-RU
